rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function role() {
      return userExists() ? userDoc().role : null;
    }

    function isAdmin() {
      return role() == 'admin';
    }

    function isTecnico() {
      return role() == 'tecnico';
    }

    function isSupervisor() {
      return role() == 'supervisor';
    }

    function isStaff() {
      return isAdmin() || isTecnico();
    }

    // El supervisor de compras puede consultar el inventario completo,
    // pero no hereda permisos de Técnico sobre préstamos, reservas o usuarios.
    function canReadInventory() {
      return isStaff() || isSupervisor();
    }

    function canReadPurchases() {
      return isAdmin() || isSupervisor();
    }

    match /zones/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subzones/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /locations/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /fabacademyWeeks/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /items/{id} {
      // Admin/Técnico/Supervisor ven todo lo activo. Alumnos y público sólo
      // ven lo explícitamente visible. La escritura continúa exclusiva de Admin.
      allow read: if canReadInventory()
        || (resource.data.activo == true && resource.data.visibleParaAlumno == true);
      allow create, update, delete: if isAdmin();
    }

    match /files/{id} {
      allow read: if resource.data.active == true || canReadInventory();
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'alumno'
        && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
      allow update: if signedIn() && (
        isAdmin()
        || (request.auth.uid == uid
          && resource.data.role == request.resource.data.role
          && request.resource.data.role == 'alumno')
      );
      allow delete: if isAdmin();
    }

    match /loanRequests/{id} {
      allow create: if signedIn()
        && request.resource.data.alumnoUid == request.auth.uid
        && request.resource.data.status == 'pendiente';
      allow read: if signedIn() && (resource.data.alumnoUid == request.auth.uid || isStaff());
      allow update, delete: if isStaff();
    }

    // Preparado para una etapa futura de reservas/asistencia de máquinas.
    match /reservationRequests/{id} {
      allow create: if signedIn()
        && request.resource.data.userUid == request.auth.uid
        && request.resource.data.status == 'pendiente';
      allow read: if signedIn() && (resource.data.userUid == request.auth.uid || isStaff());
      allow update, delete: if isStaff();
    }

    match /inventoryMovements/{id} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Compras: Admin administra; Supervisor consulta y genera reportes.
    // Las líneas de requisición/recepción se guardan dentro de items de cada
    // solicitud, por eso la misma separación read/write se aplica al subárbol.
    match /purchaseRequests/{requestId} {
      allow read: if canReadPurchases();
      allow create, update, delete: if isAdmin();

      match /items/{itemId} {
        allow read: if canReadPurchases();
        allow create, update, delete: if isAdmin();
      }
    }

    // Consecutivos/folios: sólo los modifica el administrador al enviar compras.
    match /purchaseRequestCounters/{id} {
      allow read, write: if isAdmin();
    }

    match /purchaseBudgets/{id} {
      allow read: if canReadPurchases();
      allow create, update, delete: if isAdmin();
    }
  }
}
